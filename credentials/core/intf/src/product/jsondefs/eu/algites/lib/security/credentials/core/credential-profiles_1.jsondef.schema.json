{
  "$schema": "https://defs.dev.algites.eu/api/jsonmetadefs/eu/algites/tool/codegen/defs/jsonmetadef/2020-12/dialect_1.jsonmetadef.schema.json",
  "$id": "https://defs.dev.algites.eu/api/jsondefs/eu/algites/lib/security/credentials/core/credential-profiles_1.jsondef.schema.json",
  "title": "Algites Credential Profiles v1",
  "x-algites-schema-id": "eu.algites.lib.security.credentials.core.credential-profiles",
  "x-algites-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "Optional absolute URI of the schema describing this root document."
    },
    "Profile": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CredentialProfileType"
      },
      "x-algites-defscodegen-key": {
        "id": "UniqueProfileId",
        "field-name": "Id"
      }
    }
  },
  "$defs": {
    "CredentialProfileType": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Type": {
          "$ref": "#/$defs/CredentialType"
        },
        "Configuration": {
          "$ref": "#/$defs/ConfigurationType"
        },
        "Id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "Id"
      ]
    },
    "ConfigurationType": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Entry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConfigurationEntryType"
          },
          "x-algites-defscodegen-key": {
            "id": "ConfigurationEntryByName",
            "field-name": "Name"
          }
        }
      }
    },
    "ConfigurationEntryType": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": {
          "type": "string",
          "minLength": 1
        },
        "Choice": {
          "$ref": "#/$defs/ConfigurationValueType"
        }
      },
      "required": [
        "Name",
        "Choice"
      ]
    },
    "ConfigurationValueType": {
      "description": "Exactly one explicit scalar variant, independent of the map entry key.",
      "x-algites-defscodegen-choice": true,
      "type": "object",
      "properties": {
        "StringValue": {
          "type": "string"
        },
        "IntegerValue": {
          "type": "integer"
        },
        "BooleanValue": {
          "type": "boolean"
        }
      },
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false
    },
    "CredentialType": {
      "type": "string",
      "enum": [
        "basic",
        "bearer",
        "api_key",
        "certificate"
      ]
    }
  }
}
