{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://defs.dev.algites.eu/api/jsondefs/eu/algites/lib/security/credentials/core/credential-profiles_1.jsondef.schema.json",
  "title": "Algites Credential Profiles v1",
  "type": "object",
  "propertyNames": {
    "anyOf": [
      {
        "const": "$schema"
      },
      {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    ]
  },
  "additionalProperties": {
    "$ref": "#/$defs/credentialProfile"
  },
  "$defs": {
    "credentialProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Type": {
          "type": "string",
          "enum": [
            "basic",
            "bearer",
            "api_key",
            "certificate"
          ]
        },
        "Configuration": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        }
      },
      "minProperties": 1
    }
  },
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "Optional absolute URI of the schema describing this root document."
    }
  },
  "x-algites-schema-id": "eu.algites.lib.security.credentials.core.credential-profiles",
  "x-algites-schema-version": 1
}
