<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/security/credentials/core/credential-document_1.xsd"
           targetNamespace="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/security/credentials/core/credential-document_1.xsd"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">
    <xs:simpleType name="ProfileIdType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[a-z0-9]+(-[a-z0-9]+)*"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ValueSourceType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="direct_value"/>
            <xs:enumeration value="file_content"/>
            <xs:enumeration value="secret_content"/>
            <xs:enumeration value="environment_variable_content"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="ValueReferenceType">
        <xs:sequence>
            <xs:element name="Source" type="tns:ValueSourceType"/>
            <xs:element name="Value">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:minLength value="1"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="BasicType">
        <xs:sequence>
            <xs:element name="Username" type="tns:ValueReferenceType"/>
            <xs:element name="Password" type="tns:ValueReferenceType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="BearerType">
        <xs:sequence>
            <xs:element name="Token" type="tns:ValueReferenceType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ApiKeyType">
        <xs:sequence>
            <xs:element name="ApiKey" type="tns:ValueReferenceType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CertificateType">
        <xs:sequence>
            <xs:element name="Certificate" type="tns:ValueReferenceType"/>
            <xs:element name="PrivateKey" type="tns:ValueReferenceType" minOccurs="0"/>
            <xs:element name="PrivateKeyPassword" type="tns:ValueReferenceType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ProfileType">
        <xs:all>
            <xs:element name="Basic" type="tns:BasicType" minOccurs="0" maxOccurs="1"/>
            <xs:element name="Bearer" type="tns:BearerType" minOccurs="0" maxOccurs="1"/>
            <xs:element name="ApiKey" type="tns:ApiKeyType" minOccurs="0" maxOccurs="1"/>
            <xs:element name="Certificate" type="tns:CertificateType" minOccurs="0" maxOccurs="1"/>
        </xs:all>
        <xs:attribute name="Id" type="tns:ProfileIdType" use="required"/>
    </xs:complexType>

    <xs:element name="CredentialDocument">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Profile" type="tns:ProfileType" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
        <xs:key name="UniqueProfileId">
            <xs:selector xpath="tns:Profile"/>
            <xs:field xpath="@Id"/>
        </xs:key>
    </xs:element>
</xs:schema>
