<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/security/credentials/core/credential-profiles_1.xsd"
           targetNamespace="https://defs.dev.algites.eu/api/xmldefs/eu/algites/lib/security/credentials/core/credential-profiles_1.xsd"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">
    <xs:simpleType name="CredentialProfileIdType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[a-z0-9]+(-[a-z0-9]+)*"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="CredentialType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="basic"/>
            <xs:enumeration value="bearer"/>
            <xs:enumeration value="api_key"/>
            <xs:enumeration value="certificate"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ConfigurationNameType">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Equivalent to JSON/YAML ConfigurationValueType oneOf. -->
    <xs:complexType name="ConfigurationValueType">
        <xs:choice>
            <xs:element name="StringValue" type="xs:string"/>
            <xs:element name="IntegerValue" type="xs:integer"/>
            <xs:element name="BooleanValue" type="xs:boolean"/>
        </xs:choice>
    </xs:complexType>

    <!-- Explicit XML entry stores the key and one chosen scalar value. -->
    <!-- The named Choice element mirrors the JSON/YAML Choice property. -->
    <xs:complexType name="ConfigurationEntryType">
        <xs:sequence>
            <xs:element name="Choice" type="tns:ConfigurationValueType"/>
        </xs:sequence>
        <xs:attribute name="Name" type="tns:ConfigurationNameType" use="required"/>
    </xs:complexType>

    <xs:complexType name="ConfigurationType">
        <xs:sequence>
            <xs:element name="Entry" type="tns:ConfigurationEntryType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CredentialProfileType">
        <xs:sequence>
            <xs:element name="Type" type="tns:CredentialType" minOccurs="0"/>
            <xs:element name="Configuration" type="tns:ConfigurationType" minOccurs="0">
                <xs:key name="ConfigurationEntryByName">
                    <xs:selector xpath="tns:Entry"/>
                    <xs:field xpath="@Name"/>
                </xs:key>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="Id" type="tns:CredentialProfileIdType" use="required"/>
    </xs:complexType>

    <xs:element name="CredentialProfiles">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Profile" type="tns:CredentialProfileType" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
        <xs:key name="UniqueProfileId">
            <xs:selector xpath="tns:Profile"/>
            <xs:field xpath="@Id"/>
        </xs:key>
    </xs:element>
</xs:schema>
