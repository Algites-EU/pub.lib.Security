{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/lib/security/credentials/core/credentials_1.yamldef.schema.json",
  "title": "Algites YAML Credentials v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "Optional absolute URI of the schema describing this root document."
    },
    "Profile": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProfileType"
      },
      "x-algites-defscodegen-key": {
        "id": "UniqueProfileId",
        "field-name": "Id"
      }
    }
  },
  "$defs": {
    "ProfileType": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Basic": {
          "$ref": "#/$defs/BasicType"
        },
        "Bearer": {
          "$ref": "#/$defs/BearerType"
        },
        "ApiKey": {
          "$ref": "#/$defs/ApiKeyType"
        },
        "Certificate": {
          "$ref": "#/$defs/CertificateType"
        },
        "Id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "Id"
      ]
    },
    "BasicType": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Username": {
          "$ref": "#/$defs/ValueReferenceType"
        },
        "Password": {
          "$ref": "#/$defs/ValueReferenceType"
        }
      },
      "required": [
        "Username",
        "Password"
      ]
    },
    "BearerType": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Token": {
          "$ref": "#/$defs/ValueReferenceType"
        }
      },
      "required": [
        "Token"
      ]
    },
    "ApiKeyType": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ApiKey": {
          "$ref": "#/$defs/ValueReferenceType"
        }
      },
      "required": [
        "ApiKey"
      ]
    },
    "CertificateType": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Certificate": {
          "$ref": "#/$defs/ValueReferenceType"
        },
        "PrivateKey": {
          "$ref": "#/$defs/ValueReferenceType"
        },
        "PrivateKeyPassword": {
          "$ref": "#/$defs/ValueReferenceType"
        }
      },
      "required": [
        "Certificate"
      ]
    },
    "ValueReferenceType": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Source": {
          "$ref": "#/$defs/ValueSourceType"
        },
        "Value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "Source",
        "Value"
      ]
    },
    "ValueSourceType": {
      "type": "string",
      "enum": [
        "direct_value",
        "file_content",
        "secret_content",
        "environment_variable_content"
      ]
    }
  },
  "x-algites-schema-id": "eu.algites.lib.security.credentials.core.credentials",
  "x-algites-schema-version": 1,
  "x-algites-defscodegen-root-type-name": "CredentialDocument"
}
